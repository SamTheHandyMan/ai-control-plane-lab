# Copy this file to .env and fill in real values. .env is git-ignored. Never commit it.

# Model providers (two, so fallback routing is real)
GOOGLE_API_KEY=        # Google AI Studio (Gemini) free tier
GROQ_API_KEY=          # Groq free tier

# Tracing (evening 2). Project key from HoneyHive > Settings > Project > API Keys.
HH_API_KEY=
HH_PROJECT=ai-control-plane-lab
